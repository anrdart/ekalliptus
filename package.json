{
    "name": "ekalliptus-monorepo",
    "private": true,
    "packageManager": "bun@1.3.10",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "bun run build:web && bun run build:admin",
        "dev:web": "bun --cwd apps/web run dev",
        "dev:admin": "bun --cwd apps/admin run dev",
        "build:web": "bun --cwd apps/web run build",
        "build:admin": "bun --cwd apps/admin run build",
        "deploy:web": "bun --cwd apps/web run deploy",
        "deploy:admin": "bun --cwd apps/admin run deploy",
        "migrate:blog": "bun --cwd apps/web run migrate:blog"
    }
}
