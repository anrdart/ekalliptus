---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import StatsBand from '../components/StatsBand.astro'
import Services from '../components/Services.astro'
import ProcessSteps from '../components/ProcessSteps.astro'
import Testimonials from '../components/Testimonials.astro'
import TrustBand from '../components/TrustBand.astro'
import FAQ from '../components/FAQ.astro'
import ContactCTA from '../components/ContactCTA.astro'
import ConsultationDialog from '../components/ConsultationDialog.astro'
import Navigation from '../components/Navigation.astro'
import VantaBackground from '../components/VantaBackground.astro'
import PreLoader from '../components/PreLoader.astro'
import JsonLd from '../components/JsonLd.astro'
import { t, getLocaleFromRequest, getDir } from '../i18n'
import { aggregateRating, verifiedTestimonials } from '../data/testimonials'
import { ArrowRight, ArrowUpRight, Mail, Phone, MapPin } from 'lucide-astro'

const locale = getLocaleFromRequest(Astro.request)
const dir = getDir(locale)

const FAQ_COUNT = 8
const faqItems = []
for (let i = 0; i < FAQ_COUNT; i++) {
  const question = t(`faq.items[${i}].question`)
  const answer = t(`faq.items[${i}].answer`)
  if (question && !question.includes('faq.items[')) {
    faqItems.push({ question, answer })
  }
}

// Review schema only from REAL verified testimonials (null otherwise → no schema).
const rating = aggregateRating()
const reviews = verifiedTestimonials.map((r) => ({ author: r.name, rating: r.rating, body: r.quote }))

const serviceLinks = [
  { label: t('services.cards.websiteDevelopment.title', locale), href: '/services/website' },
  { label: t('services.cards.mobileAppDevelopment.title', locale), href: '/services/mobile-app' },
  { label: t('services.cards.wordpressDevelopment.title', locale), href: '/services/wordpress' },
  { label: t('services.cards.uiUxDesign.title', locale), href: '/services/ui-ux' },
  { label: t('services.cards.photoVideoEditing.title', locale), href: '/services/multimedia' },
  { label: t('services.cards.websiteMaintenance.title', locale), href: '/services/maintenance' },
]
const year = new Date().getFullYear()
---

<Layout
  title="Ekalliptus Digital | Jasa Website & Aplikasi Mobile Terbaik Global"
  description="Jasa pembuatan website profesional, aplikasi mobile, WordPress & UI/UX design. Berbasis Global, melayani seluruh Global. Konsultasi GRATIS!"
  lang={locale}
  dir={dir}
  keywords="jasa pembuatan website, jasa aplikasi mobile, web developer Global, digital agency Global, jasa wordpress, ui ux design Global"
>
  <JsonLd locale={locale} page="home" faqItems={faqItems} aggregateRating={rating} reviews={reviews} />
  <PreLoader />
  <Navigation t={(key: string) => t(key, locale)} currentLang={locale} />

  <main class="relative z-0 flex min-h-screen flex-col pt-14 sm:pt-16 md:pt-20">
    <Hero t={(key: string) => t(key, locale)} />
    <StatsBand t={(key: string) => t(key, locale)} />
    <Services t={(key: string) => t(key, locale)} />
    <ProcessSteps t={(key: string) => t(key, locale)} />
    <Testimonials t={(key: string) => t(key, locale)} />
    <TrustBand t={(key: string) => t(key, locale)} />
    <FAQ t={(key: string) => t(key, locale)} />
    <ContactCTA t={(key: string) => t(key, locale)} />
    <ConsultationDialog t={(key: string) => t(key, locale)} />

    <!-- Blog teaser -->
    <section id="blog" class="content-vis px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:mb-12 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-semibold uppercase tracking-[0.35em] text-primary">{t('blog.badge', locale)}</span>
            <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl md:text-4xl">{t('blog.title', locale)}</h2>
            <p class="mt-2 max-w-2xl text-base text-muted-foreground">{t('blog.description', locale)}</p>
          </div>
          <a
            href="/blog"
            class="hidden flex-shrink-0 items-center gap-2 rounded-full border border-border/40 bg-card/20 px-5 py-2.5 text-sm font-semibold text-foreground/80 transition hover:bg-card/30 sm:inline-flex cursor-interactive"
          >
            {t('blog.readMore', locale)}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <a href="/blog/jasa-pembuatan-website-global" class="group glass-card overflow-hidden rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 cursor-interactive">
            <div class="skel-shimmer aspect-video overflow-hidden bg-card/30">
              <img src="/blog/jasa-website-global.svg" alt="Jasa Pembuatan Website Global" width="640" height="360" class="img-skel h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" onload="this.classList.add('img-loaded')" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
            </div>
            <div class="p-5 sm:p-6">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-primary">{t('blog.categories.web-development', locale)}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">Jasa Pembuatan Website Global: Harga & Portfolio 2026</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">Temukan layanan pembuatan website profesional di Global dengan harga terjangkau. Mulai dari Rp 1,5 juta untuk company profile.</p>
            </div>
          </a>

          <a href="/blog/biaya-pembuatan-aplikasi-android-ios" class="group glass-card overflow-hidden rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 cursor-interactive">
            <div class="skel-shimmer aspect-video overflow-hidden bg-card/30">
              <img src="/blog/biaya-aplikasi-mobile.svg" alt="Biaya Pembuatan Aplikasi Mobile" width="640" height="360" class="img-skel h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" onload="this.classList.add('img-loaded')" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
            </div>
            <div class="p-5 sm:p-6">
              <span class="rounded-full bg-accent/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-accent">{t('blog.categories.mobile-app', locale)}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">Biaya Pembuatan Aplikasi Android & iOS di Global</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">Panduan lengkap estimasi biaya pembuatan aplikasi mobile cross-platform dengan React Native dan Flutter.</p>
            </div>
          </a>

          <a href="/blog/wordpress-custom-vs-template" class="group glass-card overflow-hidden rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/5 cursor-interactive">
            <div class="skel-shimmer aspect-video overflow-hidden bg-card/30">
              <img src="/blog/wordpress-custom-vs-template.svg" alt="WordPress Custom vs Template" width="640" height="360" class="img-skel h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" decoding="async" onload="this.classList.add('img-loaded')" onerror="this.onerror=null;this.src='/blog/placeholder.svg'" />
            </div>
            <div class="p-5 sm:p-6">
              <span class="rounded-full bg-primary/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-primary">{t('blog.categories.wordpress', locale)}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary">WordPress Custom vs Template: Mana yang Lebih Baik?</h3>
              <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">Perbandingan lengkap antara WordPress custom development dengan tema premium. Pilih sesuai kebutuhan bisnis Anda.</p>
            </div>
          </a>
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90">
            {t('blog.readMore', locale)}
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer id="about" class="safe-bottom mt-8 border-t border-border/20 bg-card/5 py-12 sm:mt-12">
      <div class="mx-auto max-w-6xl px-4">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          <div class="col-span-2 md:col-span-1">
            <div class="mb-4 flex items-center gap-3">
              <img src="/ekalliptus_rounded.webp" alt="Ekalliptus Digital" width="40" height="40" class="h-9 w-auto sm:h-10" loading="lazy" decoding="async" />
              <span class="text-lg font-bold text-foreground">Ekalliptus</span>
            </div>
            <p class="max-w-xs text-sm leading-relaxed text-muted-foreground">{t('home.footer.tagline', locale)}</p>
          </div>

          <div>
            <h3 class="mb-4 text-sm font-semibold text-foreground">{t('home.footer.servicesHeading', locale)}</h3>
            <ul class="space-y-2.5 text-sm">
              {serviceLinks.map((s) => (
                <li>
                  <a href={s.href} class="text-muted-foreground transition-colors hover:text-primary">{s.label}</a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="mb-4 text-sm font-semibold text-foreground">{t('home.footer.companyHeading', locale)}</h3>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/about" class="text-muted-foreground transition-colors hover:text-primary">{t('home.footer.aboutLink', locale)}</a></li>
              <li><a href="/blog" class="text-muted-foreground transition-colors hover:text-primary">{t('home.footer.blogLink', locale)}</a></li>
              <li><a href="/order" class="text-muted-foreground transition-colors hover:text-primary">{t('home.footer.orderLink', locale)}</a></li>
              <li><a href="/privacy-policy" class="text-muted-foreground transition-colors hover:text-primary">{t('home.footer.privacyLink', locale)}</a></li>
              <li><a href="/terms-of-service" class="text-muted-foreground transition-colors hover:text-primary">{t('home.footer.termsLink', locale)}</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-4 text-sm font-semibold text-foreground">{t('home.footer.contactHeading', locale)}</h3>
            <ul class="space-y-2.5 text-sm text-muted-foreground">
              <li>
                <a href="mailto:support@ekalliptus.com" class="inline-flex items-center gap-2 transition-colors hover:text-primary">
                  <Mail class="h-4 w-4 flex-shrink-0" /> support@ekalliptus.com
                </a>
              </li>
              <li>
                <a href="https://wa.me/6281999900306" class="inline-flex items-center gap-2 transition-colors hover:text-primary">
                  <Phone class="h-4 w-4 flex-shrink-0" /> +62 819-9990-0306
                </a>
              </li>
              <li class="inline-flex items-center gap-2"><MapPin class="h-4 w-4 flex-shrink-0" /> Global</li>
            </ul>
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border/20 pt-8 md:flex-row">
          <p class="text-sm text-muted-foreground">© {year} Ekalliptus Digital. {t('home.footer.rights', locale)}</p>
          <a href="/order" class="group inline-flex items-center gap-2 text-sm font-semibold text-primary">
            {t('home.cta.primary', locale)}
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
