---
import AdminLayout from '../_layout.astro'
import { getCustomerDetail } from '../../../lib/admin/customers'
import { Mail, Phone, Building2, Calendar } from 'lucide-astro'
import { formatIDR, formatDate as fmtDate } from '../../../lib/format'

const id = Astro.params.id as string
const customer = await getCustomerDetail(id)
if (!customer) {
  return Astro.redirect('/admin/customers')
}

const formatDate = (s: string | null) => (s ? fmtDate(s) : '-')
const initials = customer.customer_name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase()
---
<AdminLayout title={customer.customer_name}>
  <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6">
    <!-- Profile -->
    <div class="space-y-4">
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="mx-auto mb-3 h-16 w-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-xl font-bold">
          {initials}
        </div>
        <h2 class="font-bold text-lg">{customer.customer_name}</h2>
        {customer.company && <p class="text-sm text-muted-foreground">{customer.company}</p>}
        <div class="mt-4 space-y-2 text-left text-sm">
          {customer.email && (
            <div class="flex items-center gap-2 text-muted-foreground"><Mail class="h-4 w-4" /> {customer.email}</div>
          )}
          <div class="flex items-center gap-2 text-muted-foreground"><Phone class="h-4 w-4" /> {customer.whatsapp}</div>
          {customer.company && (
            <div class="flex items-center gap-2 text-muted-foreground"><Building2 class="h-4 w-4" /> {customer.company}</div>
          )}
          <div class="flex items-center gap-2 text-muted-foreground"><Calendar class="h-4 w-4" /> Sejak {formatDate(customer.last_order_at)}</div>
        </div>
      </div>

      <div class="glass-card rounded-2xl p-6">
        <h3 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">Ringkasan</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between"><dt class="text-muted-foreground">Total Order</dt><dd class="font-bold">{customer.total_orders}</dd></div>
          <div class="flex justify-between"><dt class="text-muted-foreground">Total Spend</dt><dd class="font-bold text-green-600">{formatIDR(customer.total_spent)}</dd></div>
          <div class="flex justify-between"><dt class="text-muted-foreground">Konsultasi</dt><dd class="font-bold">{customer.consultations.length}</dd></div>
          <div class="flex justify-between"><dt class="text-muted-foreground">Layanan Utama</dt><dd class="font-medium">{customer.primary_service}</dd></div>
        </dl>
      </div>
    </div>

    <!-- Tabs -->
    <div class="glass-card rounded-2xl p-6">
      <div class="flex gap-2 border-b border-border mb-4 overflow-x-auto" role="tablist">
        <button class="tab-btn active px-3 py-2 text-sm font-medium" data-tab="orders">Orders ({customer.orders.length})</button>
        <button class="tab-btn px-3 py-2 text-sm font-medium text-muted-foreground" data-tab="payments">Payments ({customer.payments.length})</button>
        <button class="tab-btn px-3 py-2 text-sm font-medium text-muted-foreground" data-tab="consultations">Consultations ({customer.consultations.length})</button>
      </div>

      <div data-panel="orders">
        {customer.orders.map((o) => (
          <div class="flex items-center justify-between py-3 border-b border-border/40 text-sm">
            <div>
              <div class="font-mono text-xs text-muted-foreground">ORD-{o.id.slice(0, 8)}</div>
              <div class="font-medium">{o.service_type}</div>
              <div class="text-xs text-muted-foreground">{formatDate(o.created_at)}</div>
            </div>
            <div class="text-right">
              <div class="font-bold">{formatIDR(Number((o.pricing as any)?.grand_total ?? 0))}</div>
              <div class="text-xs text-muted-foreground">{o.status}</div>
            </div>
          </div>
        ))}
      </div>

      <div data-panel="payments" hidden>
        {customer.payments.map((p) => (
          <div class="flex items-center justify-between py-3 border-b border-border/40 text-sm">
            <div>
              <div class="font-medium">{p.gateway}</div>
              <div class="text-xs text-muted-foreground">{formatDate(p.created_at)}</div>
            </div>
            <div class="text-right">
              <div class="font-bold">{formatIDR(Number(p.amount))}</div>
              <div class="text-xs">{p.status}</div>
            </div>
          </div>
        ))}
      </div>

      <div data-panel="consultations" hidden>
        {customer.consultations.map((c) => (
          <div class="py-3 border-b border-border/40 text-sm">
            <div class="font-medium">{c.visitor_name ?? 'Konsultasi'}</div>
            <div class="text-xs text-muted-foreground">{formatDate(c.created_at)} · status {c.status}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .tab-btn { border-bottom: 2px solid transparent; }
    .tab-btn.active { border-bottom-color: hsl(var(--primary)); color: hsl(var(--primary)); }
  </style>

  <script>
    document.querySelectorAll<HTMLElement>('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab!
        document.querySelectorAll<HTMLElement>('.tab-btn').forEach((b) => {
          b.classList.toggle('active', b === btn)
          b.classList.toggle('text-muted-foreground', b !== btn)
        })
        document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          p.hidden = p.dataset.panel !== tab
        })
      })
    })
  </script>
</AdminLayout>
