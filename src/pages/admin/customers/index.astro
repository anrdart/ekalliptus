---
import AdminLayout from '../layout.astro'
import SearchFilter from '../../../components/admin/SearchFilter.astro'
import Pagination from '../../../components/admin/Pagination.astro'
import EmptyState from '../../../components/admin/EmptyState.astro'
import { listCustomers } from '../../../lib/admin/customers'
import { Users, Eye, MessageSquare } from 'lucide-astro'

const url = new URL(Astro.request.url)
const search = url.searchParams.get('search') ?? ''
const service = url.searchParams.get('service') ?? ''
const sort = (url.searchParams.get('sort') ?? 'recent') as 'recent' | 'spend' | 'orders'
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1'))

const { customers, total, totalPages } = await listCustomers({ search, service, sort, page })

const formatIDR = (n: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n)

const baseUrl = `/admin/customers?search=${encodeURIComponent(search)}&service=${service}&sort=${sort}`
---
<AdminLayout title="Customers">
  <SearchFilter
    placeholder="Cari nama, email, WhatsApp..."
    value={search}
    name="search"
    action="/admin/customers"
    filters={[
      {
        name: 'service',
        label: 'Layanan',
        selected: service,
        options: [
          { value: '', label: 'Semua Layanan' },
          { value: 'website', label: 'Website' },
          { value: 'wordpress', label: 'WordPress' },
          { value: 'mobile', label: 'Mobile App' },
          { value: 'editing', label: 'Editing' },
          { value: 'service_device', label: 'Service Device' }
        ]
      },
      {
        name: 'sort',
        label: 'Urutkan',
        selected: sort,
        options: [
          { value: 'recent', label: 'Terbaru' },
          { value: 'spend', label: 'Total Spend' },
          { value: 'orders', label: 'Total Order' }
        ]
      }
    ]}
  />

  <div class="glass-card rounded-2xl p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">{total} pelanggan</h2>
    </div>

    {customers.length === 0 ? (
      <EmptyState
        icon={Users}
        title="Belum ada pelanggan"
        description="Pelanggan akan muncul di sini setelah ada order pertama masuk."
      />
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border text-left text-xs font-medium text-muted-foreground">
              <th class="pb-3">Nama</th>
              <th class="pb-3">Kontak</th>
              <th class="pb-3">Layanan</th>
              <th class="pb-3 text-right">Total Order</th>
              <th class="pb-3 text-right">Total Spend</th>
              <th class="pb-3"></th>
            </tr>
          </thead>
          <tbody>
            {customers.map((c) => (
              <tr class="border-b border-border/50 hover:bg-accent/40 transition">
                <td class="py-3">
                  <div class="font-medium">{c.customer_name}</div>
                  {c.company && <div class="text-xs text-muted-foreground">{c.company}</div>}
                </td>
                <td class="py-3 text-xs text-muted-foreground">
                  {c.email && <div>{c.email}</div>}
                  <div>{c.whatsapp}</div>
                </td>
                <td class="py-3">
                  <span class="rounded-full bg-primary/10 text-primary px-2 py-0.5 text-xs">{c.primary_service}</span>
                </td>
                <td class="py-3 text-right font-medium">{c.total_orders}</td>
                <td class="py-3 text-right font-medium text-green-600">{formatIDR(c.total_spent)}</td>
                <td class="py-3 text-right">
                  <a href={`/admin/customers/${c.id}`} class="inline-flex items-center gap-1 text-primary hover:underline text-xs">
                    <Eye class="h-3.5 w-3.5" /> Detail
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <Pagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
      </div>
    )}
  </div>
</AdminLayout>
