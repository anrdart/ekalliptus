---
import AdminLayout from '../_layout.astro'
import RevenueChart from '../../../components/admin/RevenueChart.astro'
import FunnelChart from '../../../components/admin/FunnelChart.astro'
import { revenueSeries, funnelStats, breakdownByService, breakdownByLeadSource, breakdownByCustomer, type Granularity } from '../../../lib/admin/analytics'
import { Download } from 'lucide-astro'

const url = new URL(Astro.request.url)
const today = new Date().toISOString().slice(0, 10)
const monthAgo = new Date(Date.now() - 30 * 86400_000).toISOString().slice(0, 10)
const from = url.searchParams.get('from') ?? monthAgo
const to = url.searchParams.get('to') ?? today
const granularity = (url.searchParams.get('granularity') ?? 'day') as Granularity

const [series, stages, services, sources, customers] = await Promise.all([
  revenueSeries({ from, to, granularity }),
  funnelStats(from, to),
  breakdownByService(from, to),
  breakdownByLeadSource(from, to),
  breakdownByCustomer(from, to)
])

const seriesForChart = series.map((p) => ({ day: p.bucket, value: p.value }))
const fmt = (n: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n)
---
<AdminLayout title="Reports">
  <form method="GET" action="/admin/reports" class="glass-card rounded-2xl p-4 mb-6 flex flex-wrap gap-3 items-end">
    <label class="block">
      <span class="text-xs text-muted-foreground">Dari</span>
      <input type="date" name="from" value={from} class="block mt-1 rounded-lg border border-border bg-background px-2 py-1 text-sm" />
    </label>
    <label class="block">
      <span class="text-xs text-muted-foreground">Sampai</span>
      <input type="date" name="to" value={to} class="block mt-1 rounded-lg border border-border bg-background px-2 py-1 text-sm" />
    </label>
    <label class="block">
      <span class="text-xs text-muted-foreground">Granularitas</span>
      <select name="granularity" class="block mt-1 rounded-lg border border-border bg-background px-2 py-1 text-sm">
        <option value="day" selected={granularity === 'day'}>Harian</option>
        <option value="week" selected={granularity === 'week'}>Mingguan</option>
        <option value="month" selected={granularity === 'month'}>Bulanan</option>
      </select>
    </label>
    <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground">Terapkan</button>
    <a href={`/api/admin/reports/export?type=orders&from=${from}&to=${to}`} class="ml-auto inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm hover:bg-accent/40">
      <Download class="h-4 w-4" /> Export Orders CSV
    </a>
    <a href={`/api/admin/reports/export?type=payments&from=${from}&to=${to}`} class="inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm hover:bg-accent/40">
      <Download class="h-4 w-4" /> Export Payments CSV
    </a>
  </form>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="lg:col-span-2 glass-card rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-4">Revenue</h2>
      <RevenueChart series={seriesForChart} height={260} />
    </div>
    <div class="glass-card rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-4">Conversion Funnel</h2>
      <FunnelChart stages={stages} />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="glass-card rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-4">Breakdown per Layanan</h2>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-muted-foreground border-b border-border"><th class="pb-2">Layanan</th><th class="pb-2 text-right">Order</th><th class="pb-2 text-right">Revenue</th></tr></thead>
        <tbody>
          {services.map((s) => (
            <tr class="border-b border-border/40">
              <td class="py-2">{s.name}</td>
              <td class="py-2 text-right">{s.orders}</td>
              <td class="py-2 text-right font-medium">{fmt(s.revenue)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="glass-card rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-4">Top Customers</h2>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-muted-foreground border-b border-border"><th class="pb-2">Customer</th><th class="pb-2 text-right">Order</th><th class="pb-2 text-right">Spend</th></tr></thead>
        <tbody>
          {customers.map((c) => (
            <tr class="border-b border-border/40">
              <td class="py-2"><a href={`/admin/customers/${c.customer_id}`} class="hover:underline">{c.name}</a></td>
              <td class="py-2 text-right">{c.orders}</td>
              <td class="py-2 text-right font-medium">{fmt(c.revenue)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="glass-card rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-4">Sumber Lead</h2>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-muted-foreground border-b border-border"><th class="pb-2">Source</th><th class="pb-2 text-right">Jumlah</th></tr></thead>
        <tbody>
          {sources.map((s) => (
            <tr class="border-b border-border/40"><td class="py-2">{s.source}</td><td class="py-2 text-right font-medium">{s.count}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
