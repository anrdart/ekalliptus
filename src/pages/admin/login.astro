---
import '../../styles/global.css'
import { LayoutDashboard } from 'lucide-astro'

const next = Astro.url.searchParams.get('next') ?? '/admin'
const error = Astro.url.searchParams.get('error')

const errorMessages: Record<string, string> = {
  invalid: 'Email atau password salah.',
  server: 'Server Supabase belum dikonfigurasi. Cek SUPABASE_SERVICE_ROLE_KEY di .env.',
  no_profile: 'User berhasil login tapi belum punya row di tabel profiles. Insert profile dengan role owner.',
  empty: 'Email dan password wajib diisi.'
}
const errorMessage = error ? (errorMessages[error] ?? 'Login gagal. Coba lagi.') : null
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login | Ekalliptus Digital</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-mesh min-h-screen text-foreground flex items-center justify-center p-4" data-admin="true">
  <div class="bg-grid pointer-events-none fixed inset-0 opacity-50"></div>
  <main class="glass-card relative z-10 w-full max-w-sm overflow-hidden rounded-3xl p-7">
    <div class="bg-primary pointer-events-none absolute inset-x-0 top-0 h-1 opacity-80"></div>
    <div class="bg-primary mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl shadow-lg">
      <LayoutDashboard class="h-7 w-7 text-white" />
    </div>
    <h1 class="mb-1 text-center text-xl font-bold tracking-tight">Admin Login</h1>
    <p class="mb-6 text-center text-sm text-muted-foreground">Ekalliptus Digital</p>
    {errorMessage && (
      <div class="mb-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
        {errorMessage}
      </div>
    )}
    <form method="POST" action="/api/admin/login" class="space-y-3">
      <input type="hidden" name="next" value={next} />
      <label class="block">
        <span class="text-xs font-medium text-muted-foreground">Email</span>
        <input type="email" name="email" required autocomplete="username" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <label class="block">
        <span class="text-xs font-medium text-muted-foreground">Password</span>
        <input type="password" name="password" required autocomplete="current-password" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <button type="submit" class="inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
        Masuk
      </button>
    </form>
  </main>
</body>
</html>
