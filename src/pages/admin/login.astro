---
import '../../styles/global.css'

const next = Astro.url.searchParams.get('next') ?? '/admin'
const error = Astro.url.searchParams.get('error')

const errorMessages: Record<string, string> = {
  invalid: 'Email atau password salah.',
  server: 'Server Supabase belum dikonfigurasi. Cek SUPABASE_SERVICE_ROLE_KEY di .env.',
  no_profile: 'User berhasil login tapi belum punya row di tabel profiles. Insert profile dengan role owner.',
  empty: 'Email dan password wajib diisi.'
}
const errorMessage = error ? (errorMessages[error] ?? 'Login gagal. Coba lagi.') : null
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login | Ekalliptus Digital</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-background min-h-screen text-foreground flex items-center justify-center p-4" data-admin="true">
  <main class="glass-panel relative z-10 w-full max-w-sm rounded-3xl p-8">
    <div class="flex flex-col items-center mb-6">
      <img src="/logo_mobile.webp" alt="Ekalliptus Digital" width="48" height="32" class="h-12 w-auto mb-4 invert dark:invert-0" />
      <h1 class="text-xl font-bold tracking-tight">Admin Login</h1>
      <p class="text-xs text-muted-foreground mt-0.5">Ekalliptus Digital</p>
    </div>
    {errorMessage && (
      <div class="mb-4 rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
        {errorMessage}
      </div>
    )}
    <form method="POST" action="/api/admin/login" class="space-y-4">
      <input type="hidden" name="next" value={next} />
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Email</span>
        <input type="email" name="email" required autocomplete="username" class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 transition" />
      </label>
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Password</span>
        <input type="password" name="password" required autocomplete="current-password" class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 transition" />
      </label>
      <button type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition active:scale-[0.98]">
        Masuk
      </button>
    </form>
    <a href="/" class="mt-5 block text-center text-xs text-muted-foreground hover:text-foreground transition">← Kembali ke beranda</a>
  </main>
</body>
</html>
