---
import AdminLayout from '../_layout.astro'
import BlogEditor from '../../../components/admin/editor/BlogEditor.tsx'
import { getPost } from '../../../lib/admin/blog'
import { Trash2, ArrowLeft } from 'lucide-astro'

const id = Astro.params.id as string
const post = await getPost(id)
if (!post) return Astro.redirect('/admin/blog')
---
<AdminLayout title={post.title}>
  <a href="/admin/blog" class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground mb-4 transition">
    <ArrowLeft class="h-3.5 w-3.5" /> Kembali ke blog
  </a>
  <form id="edit-post-form" class="glass-panel rounded-2xl p-5 sm:p-6 max-w-3xl space-y-4" data-id={id}>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Judul</span>
        <input name="title" value={post.title} required class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 transition" />
      </label>
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Slug</span>
        <input name="slug" value={post.slug} required class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 transition" />
      </label>
    </div>
    <div class="block">
      <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide mb-1.5 block">Konten</span>
      <BlogEditor client:only="react" initialContent={post.body_html ?? ''} />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Status</span>
        <select name="status" class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
          <option value="draft" selected={post.status === 'draft'}>Draft</option>
          <option value="published" selected={post.status === 'published'}>Published</option>
          <option value="archived" selected={post.status === 'archived'}>Archived</option>
        </select>
      </label>
      <label class="block">
        <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wide">Kategori</span>
        <input name="category" value={post.category ?? ''} class="mt-1.5 block w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 transition" />
      </label>
    </div>
    <div class="flex justify-between gap-2 pt-2">
      <button type="button" id="delete-btn" class="inline-flex items-center gap-1 rounded-lg border border-destructive/40 text-destructive px-3 py-1.5 text-sm hover:bg-destructive/10 transition"><Trash2 class="h-3.5 w-3.5" /> Hapus</button>
      <div class="flex gap-2">
        <a href="/admin/blog" class="rounded-lg border border-border px-3 py-1.5 text-sm hover:bg-accent/40 transition">Batal</a>
        <button type="submit" class="rounded-lg bg-primary px-4 py-1.5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition">Simpan</button>
      </div>
    </div>
  </form>

  <script>
    const form = document.getElementById('edit-post-form') as HTMLFormElement
    const id = form.dataset.id!
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fd = new FormData(form)
      const data: any = Object.fromEntries(fd)
      const res = await fetch(`/api/admin/blog/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      if (res.ok) window.location.href = '/admin/blog'
      else alert('Gagal menyimpan')
    })
    document.getElementById('delete-btn')!.addEventListener('click', async () => {
      if (!confirm('Hapus post ini?')) return
      const res = await fetch(`/api/admin/blog/${id}`, { method: 'DELETE' })
      if (res.ok) window.location.href = '/admin/blog'
    })
  </script>
</AdminLayout>
