---
import AdminLayout from '../_layout.astro'
import BlogEditor from '../../../components/admin/editor/BlogEditor.tsx'
---
<AdminLayout title="Post Baru">
  <form id="new-post-form" class="glass-card rounded-2xl p-6 max-w-3xl space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <label class="block">
        <span class="text-xs text-muted-foreground">Judul</span>
        <input name="title" required class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Slug</span>
        <input name="slug" required class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
    </div>
    <div class="grid grid-cols-3 gap-3">
      <label class="block">
        <span class="text-xs text-muted-foreground">Bahasa</span>
        <select name="locale" required class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm">
          <option value="id">Global</option><option value="en">English</option><option value="ja">日本語</option>
          <option value="ko">한국어</option><option value="ru">Русский</option><option value="ar">العربية</option><option value="tr">Türkçe</option>
        </select>
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Kategori</span>
        <input name="category" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Tags (pisah koma)</span>
        <input name="tags" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
    </div>
    <label class="block">
      <span class="text-xs text-muted-foreground">Deskripsi (meta)</span>
      <textarea name="description" rows="2" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm"></textarea>
    </label>
    <div class="block">
      <span class="text-xs text-muted-foreground mb-1 block">Body Content</span>
      <BlogEditor client:only="react" />
    </div>
    <div class="grid grid-cols-3 gap-3">
      <label class="block">
        <span class="text-xs text-muted-foreground">Image URL</span>
        <input name="image" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Image Alt</span>
        <input name="image_alt" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" />
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Status</span>
        <select name="status" class="mt-1 block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm">
          <option value="draft">Draft</option><option value="published">Published</option><option value="archived">Archived</option>
        </select>
      </label>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="featured" /> Featured
    </label>
    <div class="flex justify-end gap-2">
      <a href="/admin/blog" class="rounded-lg border border-border px-4 py-2 text-sm">Batal</a>
      <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm text-primary-foreground">Simpan</button>
    </div>
  </form>

  <script>
    const form = document.getElementById('new-post-form') as HTMLFormElement
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fd = new FormData(form)
      const data: any = Object.fromEntries(fd)
      data.tags = (data.tags ?? '').split(',').map((s: string) => s.trim()).filter(Boolean)
      data.featured = !!fd.get('featured')
      const res = await fetch('/api/admin/blog', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      if (res.ok) {
        const { post } = await res.json()
        window.location.href = `/admin/blog/${post.id}`
      } else {
        const { error } = await res.json().catch(() => ({ error: 'gagal' }))
        alert(`Gagal: ${error}`)
      }
    })
  </script>
</AdminLayout>
