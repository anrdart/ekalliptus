---
import AdminLayout from '../_layout.astro'
import SearchFilter from '../../../components/admin/SearchFilter.astro'
import Pagination from '../../../components/admin/Pagination.astro'
import EmptyState from '../../../components/admin/EmptyState.astro'
import StatusBadge from '../../../components/admin/ui/StatusBadge.astro'
import Button from '../../../components/admin/ui/Button.astro'
import { FileText, Plus } from 'lucide-astro'
import { listPosts } from '../../../lib/admin/blog'
import { formatDate } from '../../../lib/format'

const url = new URL(Astro.request.url)
const search = url.searchParams.get('search') ?? ''
const status = url.searchParams.get('status') ?? ''
const locale = url.searchParams.get('locale') ?? ''
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1'))

const { posts, total, totalPages } = await listPosts({
  search: search || undefined,
  status: (status || undefined) as any,
  locale: locale || undefined,
  page
})
const baseUrl = `/admin/blog?search=${encodeURIComponent(search)}&status=${status}&locale=${locale}`
---
<AdminLayout title="Blog">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold"><span class="text-primary">{total}</span> post</h2>
    <Button href="/admin/blog/new" size="sm">
      <Plus class="h-4 w-4" /> Tulis Post Baru
    </Button>
  </div>

  <SearchFilter
    placeholder="Cari judul..."
    value={search}
    name="search"
    action="/admin/blog"
    filters={[
      { name: 'status', label: 'Status', selected: status, options: [
        { value: '', label: 'Semua Status' },
        { value: 'draft', label: 'Draft' },
        { value: 'published', label: 'Published' },
        { value: 'archived', label: 'Archived' }
      ]},
      { name: 'locale', label: 'Bahasa', selected: locale, options: [
        { value: '', label: 'Semua Bahasa' },
        { value: 'id', label: 'Indonesia' },
        { value: 'en', label: 'English' },
        { value: 'ja', label: '日本語' },
        { value: 'ko', label: '한국어' },
        { value: 'ru', label: 'Русский' },
        { value: 'ar', label: 'العربية' },
        { value: 'tr', label: 'Türkçe' }
      ]}
    ]}
  />

  <div class="glass-card rounded-2xl p-6">
    {posts.length === 0 ? (
      <EmptyState icon={FileText} title="Belum ada post" ctaLabel="Tulis Post Pertama" ctaHref="/admin/blog/new" />
    ) : (
      <ul class="divide-y divide-border/40">
        {posts.map((p) => (
          <li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0">
              <a href={`/admin/blog/${p.id}`} class="font-medium hover:text-primary">{p.title}</a>
              <div class="text-xs text-muted-foreground">{p.category} · {p.locale} · diperbarui {formatDate(p.updated_at)}</div>
            </div>
            <StatusBadge status={p.status} />
          </li>
        ))}
      </ul>
    )}
    <Pagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
  </div>
</AdminLayout>
