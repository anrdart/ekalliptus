---
import '../../styles/global.css'
import { Menu, X, LayoutDashboard, Users, Columns3, CheckSquare, ShoppingCart, CreditCard as Payment, MessageSquare, BarChart3, Settings, LogOut, User, FileText, Ticket, History, Moon, Sun } from 'lucide-astro'
import NotificationBell from '../../components/admin/NotificationBell.astro'

interface Props {
  title?: string
}

const { title = 'Dashboard' } = Astro.props

// Two nav groups: primary mirrors the public flow, business is supporting tooling.
const primaryLinks = [
  { key: 'dashboard', href: '/admin', icon: LayoutDashboard, label: 'Dashboard' },
  { key: 'orders', href: '/admin/orders', icon: ShoppingCart, label: 'Orders' },
  { key: 'pipeline', href: '/admin/pipeline', icon: Columns3, label: 'Pipeline' },
  { key: 'consultations', href: '/admin/consultations', icon: MessageSquare, label: 'Live Chat' },
  { key: 'blog', href: '/admin/blog', icon: FileText, label: 'Blog' }
]

const businessLinks = [
  { key: 'customers', href: '/admin/customers', icon: Users, label: 'Customers' },
  { key: 'payments', href: '/admin/payments', icon: Payment, label: 'Payments' },
  { key: 'vouchers', href: '/admin/vouchers', icon: Ticket, label: 'Vouchers' },
  { key: 'activities', href: '/admin/activities', icon: CheckSquare, label: 'Activities' },
  { key: 'reports', href: '/admin/reports', icon: BarChart3, label: 'Reports' },
  { key: 'audit', href: '/admin/audit-logs', icon: History, label: 'Audit Logs' },
  { key: 'settings', href: '/admin/settings', icon: Settings, label: 'Settings' }
]

const session = Astro.locals.adminSession
const role = session?.role ?? 'admin'

function canSee(key: string): boolean {
  if (role === 'owner' || role === 'admin') return true
  if (key === 'blog') return role === 'editor'
  if (key === 'vouchers' || key === 'payments' || key === 'reports') return role === 'finance'
  if (key === 'consultations') return role === 'cs'
  if (key === 'orders' || key === 'customers' || key === 'pipeline' || key === 'activities' || key === 'dashboard') return true
  return false
}

const visiblePrimary = primaryLinks.filter((l) => canSee(l.key))
const visibleBusiness = businessLinks.filter((l) => canSee(l.key))

const currentPath = Astro.url.pathname

function isActivePath(href: string): boolean {
  return href === '/admin' ? currentPath === href : currentPath.startsWith(href)
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Admin | Ekalliptus Digital</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-background text-foreground min-h-screen" data-admin="true">
  <!-- Mobile backdrop -->
  <div id="admin-backdrop" class="fixed inset-0 bg-background/80 backdrop-blur-sm z-40 md:hidden hidden"></div>

  <!-- Mobile drawer -->
  <div id="admin-mobile-menu" class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] overflow-y-auto glass-panel border-r border-border p-4 md:hidden hidden custom-scrollbar translate-x-[-100%] transition-transform duration-300">
    <div class="flex items-center justify-between mb-4 px-1">
      <a href="/admin" class="flex items-center gap-2">
        <img src="/logo_mobile.webp" alt="Ekalliptus Digital" width="32" height="21" class="h-8 w-auto invert dark:invert-0" />
        <span class="font-semibold text-sm">Admin</span>
      </a>
      <button id="close-mobile-menu" class="h-8 w-8 rounded-full flex items-center justify-center hover:bg-accent transition cursor-pointer" aria-label="Close menu">
        <X class="h-4 w-4" />
      </button>
    </div>
    <nav class="flex flex-col gap-0.5">
      {visiblePrimary.map((link) => (
        <a
          href={link.href}
          class:list={[
            'flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition hover:bg-accent/40 cursor-interactive sidebar-link',
            { active: isActivePath(link.href) }
          ]}
        >
          <link.icon class="h-4 w-4 flex-shrink-0" />
          {link.label}
        </a>
      ))}
      {visibleBusiness.length > 0 && (
        <>
          <div class="px-3 pt-4 pb-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/60">Bisnis</div>
          {visibleBusiness.map((link) => (
            <a
              href={link.href}
              class:list={[
                'flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition hover:bg-accent/40 cursor-interactive sidebar-link',
                { active: isActivePath(link.href) }
              ]}
            >
              <link.icon class="h-4 w-4 flex-shrink-0" />
              {link.label}
            </a>
          ))}
        </>
      )}
    </nav>
    <div class="mt-4 pt-4 border-t border-border">
      <div class="flex items-center gap-2.5 mb-3 px-1">
        <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center">
          <User class="h-4 w-4 text-primary" />
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-medium truncate">{session?.displayName ?? 'Admin'}</p>
          <p class="text-[10px] text-muted-foreground truncate">{role}</p>
        </div>
      </div>
      <button
        id="mobile-logout-btn"
        class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium text-destructive transition hover:bg-destructive/10 cursor-interactive"
      >
        <LogOut class="h-4 w-4" />
        Logout
      </button>
    </div>
  </div>

  <div class="flex min-h-screen">
    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex md:w-60 flex-col fixed h-full glass-panel border-r border-border overflow-hidden">
      <!-- Logo -->
      <div class="px-5 py-4 border-b border-border">
        <a href="/admin" class="flex items-center gap-2.5">
          <img
            src="/logo_mobile.webp"
            alt="Ekalliptus Digital"
            width="32"
            height="21"
            class="h-8 w-auto invert dark:invert-0"
          />
          <div class="leading-tight">
            <h1 class="font-semibold text-sm">Admin</h1>
            <p class="text-[10px] text-muted-foreground">Ekalliptus Digital</p>
          </div>
        </a>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto custom-scrollbar">
        {visiblePrimary.map((link) => (
          <a
            href={link.href}
            class:list={[
              'sidebar-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition cursor-interactive',
              { active: isActivePath(link.href) }
            ]}
          >
            <link.icon class="h-4 w-4 flex-shrink-0" />
            {link.label}
          </a>
        ))}
        {visibleBusiness.length > 0 && (
          <div class="px-3 pt-5 pb-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground/60">Bisnis</div>
        )}
        {visibleBusiness.map((link) => (
          <a
            href={link.href}
            class:list={[
              'sidebar-link flex items-center gap-2.5 rounded-lg px-3 py-2 text-[13px] font-medium transition cursor-interactive',
              { active: isActivePath(link.href) }
            ]}
          >
            <link.icon class="h-4 w-4 flex-shrink-0" />
            {link.label}
          </a>
        ))}
      </nav>

      <!-- User footer -->
      <div class="px-3 py-3 border-t border-border">
        <div class="flex items-center gap-2.5 mb-2">
          <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
            <User class="h-4 w-4 text-primary" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-medium truncate">{session?.displayName ?? 'Admin User'}</p>
            <p class="text-[10px] text-muted-foreground truncate">{session?.user.email ?? ''}</p>
          </div>
        </div>
        <button
          id="desktop-logout-btn"
          class="flex w-full items-center justify-center gap-2 rounded-lg border border-border px-3 py-1.5 text-[13px] font-medium text-destructive transition hover:bg-destructive/10 cursor-interactive"
        >
          <LogOut class="h-3.5 w-3.5" />
          Logout
        </button>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 md:ml-60">
      <!-- Top bar -->
      <header class="sticky top-0 z-30 glass-panel border-b border-border">
        <div class="flex items-center justify-between px-4 sm:px-6 h-14">
          <div class="flex items-center gap-3">
            <button
              id="mobile-menu-toggle"
              class="md:hidden h-9 w-9 rounded-full glass-panel flex items-center justify-center cursor-pointer hover:bg-accent transition"
              aria-label="Toggle menu"
            >
              <Menu class="h-4 w-4" />
            </button>
            <h1 class="text-base font-semibold tracking-tight" id="page-title">{title}</h1>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="admin-theme-toggle"
              class="h-9 w-9 rounded-full glass-panel flex items-center justify-center hover:bg-accent transition cursor-pointer"
              aria-label="Toggle theme"
            >
              <Sun class="h-4 w-4 dark-icon" />
              <Moon class="h-4 w-4 light-icon hidden" />
            </button>
            <NotificationBell />
            <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-full glass-pill">
              <div class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></div>
              <span class="text-[11px] font-medium">Online</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Page content -->
      <main class="p-4 sm:p-6">
        <slot />
      </main>
    </div>
  </div>

  <style>
    .sidebar-link {
      color: hsl(var(--muted-foreground));
      position: relative;
    }

    .sidebar-link:hover {
      background: hsl(var(--accent) / 0.1);
      color: hsl(var(--foreground));
    }

    .sidebar-link.active {
      background: linear-gradient(
        100deg,
        hsl(var(--primary) / 0.14),
        hsl(var(--accent-2) / 0.10)
      );
      color: hsl(var(--primary));
      border: 1px solid hsl(var(--primary) / 0.2);
      box-shadow: 0 4px 14px -6px hsl(var(--primary) / 0.22);
    }

    /* active indicator rail */
    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -1px;
      top: 50%;
      transform: translateY(-50%);
      height: 60%;
      width: 2px;
      border-radius: 0 3px 3px 0;
      background: hsl(var(--primary));
    }

    #admin-mobile-menu:not(.hidden) {
      transform: translateX(0);
    }
  </style>

  <script>
    const mobileToggle = document.getElementById('mobile-menu-toggle')
    const mobileMenu = document.getElementById('admin-mobile-menu')
    const backdrop = document.getElementById('admin-backdrop')
    const closeMobileMenu = document.getElementById('close-mobile-menu')

    let menuOpen = false

    function toggleMenu() {
      menuOpen = !menuOpen
      if (mobileMenu) mobileMenu.classList.toggle('hidden', !menuOpen)
      if (backdrop) backdrop.classList.toggle('hidden', !menuOpen)
    }

    function closeMenu() {
      menuOpen = false
      if (mobileMenu) mobileMenu.classList.add('hidden')
      if (backdrop) backdrop.classList.add('hidden')
    }

    if (mobileToggle) mobileToggle.addEventListener('click', toggleMenu)
    if (closeMobileMenu) closeMobileMenu.addEventListener('click', closeMenu)
    if (backdrop) backdrop.addEventListener('click', closeMenu)

    // Logout handlers
    const desktopLogout = document.getElementById('desktop-logout-btn')
    const mobileLogout = document.getElementById('mobile-logout-btn')

    async function handleLogout() {
      if (confirm('Are you sure you want to logout?')) {
        try {
          const response = await fetch('/api/admin/logout', { method: 'POST' })
          if (response.ok) {
            window.location.href = '/admin/login'
          }
        } catch (error) {
          console.error('Logout error:', error)
        }
      }
    }

    if (desktopLogout) desktopLogout.addEventListener('click', handleLogout)
    if (mobileLogout) mobileLogout.addEventListener('click', handleLogout)

    // Close menu on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) {
        closeMenu()
      }
    })

    // Theme toggle (mirrors public site behavior)
    const themeToggleBtn = document.getElementById('admin-theme-toggle')
    const sunIcon = themeToggleBtn?.querySelector('.dark-icon')
    const moonIcon = themeToggleBtn?.querySelector('.light-icon')
    function syncThemeIcons(isDark: boolean) {
      if (sunIcon) sunIcon.classList.toggle('hidden', !isDark)
      if (moonIcon) moonIcon.classList.toggle('hidden', isDark)
    }
    const initialTheme = localStorage.getItem('ekal-theme') || 'dark'
    document.documentElement.classList.toggle('dark', initialTheme === 'dark')
    syncThemeIcons(initialTheme === 'dark')
    themeToggleBtn?.addEventListener('click', () => {
      const root = document.documentElement
      const isDark = root.classList.contains('dark')
      root.classList.add('theme-transitioning')
      root.classList.toggle('dark', !isDark)
      localStorage.setItem('ekal-theme', isDark ? 'light' : 'dark')
      syncThemeIcons(!isDark)
      setTimeout(() => root.classList.remove('theme-transitioning'), 320)
    })
  </script>
</body>
</html>
