---
import AdminLayout from '../layout.astro'
import SearchFilter from '../../../components/admin/SearchFilter.astro'
import Pagination from '../../../components/admin/Pagination.astro'
import EmptyState from '../../../components/admin/EmptyState.astro'
import { ShoppingCart, Eye } from 'lucide-astro'
import { getSupabase } from '../../../lib/supabase'

const url = new URL(Astro.request.url)
const search = url.searchParams.get('search') ?? ''
const service = url.searchParams.get('service') ?? ''
const status = url.searchParams.get('status') ?? ''
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1'))
const pageSize = 20
const from = (page - 1) * pageSize
const to = from + pageSize - 1

const supabase = getSupabase(true)
let orders: any[] = []
let total = 0
if (supabase) {
  let q = supabase.from('orders').select('*', { count: 'exact' }).order('created_at', { ascending: false }).range(from, to)
  if (search) q = q.or(`customer_name.ilike.%${search}%,email.ilike.%${search}%,whatsapp.ilike.%${search}%`)
  if (service) q = q.eq('service_type', service as any)
  if (status) q = q.eq('status', status as any)
  const { data, count } = await q
  orders = data ?? []
  total = count ?? 0
}
const totalPages = Math.max(1, Math.ceil(total / pageSize))
const fmt = (n: number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(n)
const baseUrl = `/admin/orders?search=${encodeURIComponent(search)}&service=${service}&status=${status}`
---
<AdminLayout title="Orders">
  <SearchFilter
    placeholder="Cari nama, email, WA..."
    value={search}
    name="search"
    action="/admin/orders"
    filters={[
      { name: 'service', label: 'Layanan', selected: service, options: [
        { value: '', label: 'Semua Layanan' },
        { value: 'website', label: 'Website' },
        { value: 'wordpress', label: 'WordPress' },
        { value: 'mobile', label: 'Mobile App' },
        { value: 'editing', label: 'Editing' },
        { value: 'service_device', label: 'Service Device' }
      ]},
      { name: 'status', label: 'Status', selected: status, options: [
        { value: '', label: 'Semua Status' },
        { value: 'waiting_dp', label: 'Waiting DP' },
        { value: 'dp_paid', label: 'DP Paid' },
        { value: 'waiting_onsite_payment', label: 'Waiting Onsite' },
        { value: 'onsite_paid', label: 'Onsite Paid' },
        { value: 'cancelled', label: 'Cancelled' }
      ]}
    ]}
  />

  <div class="glass-card rounded-2xl p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">{total} order</h2>
    </div>
    {orders.length === 0 ? (
      <EmptyState icon={ShoppingCart} title="Belum ada order" description="Order yang masuk akan muncul di sini." />
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border text-left text-xs font-medium text-muted-foreground">
              <th class="pb-3">Order ID</th><th class="pb-3">Customer</th><th class="pb-3">Layanan</th><th class="pb-3 text-right">Total</th><th class="pb-3">Status</th><th class="pb-3"></th>
            </tr>
          </thead>
          <tbody>
            {orders.map((o) => (
              <tr class="border-b border-border/40 hover:bg-accent/40">
                <td class="py-3 font-mono text-xs">ORD-{o.id.slice(0, 8)}</td>
                <td class="py-3">
                  <div class="font-medium">{o.customer_name}</div>
                  <div class="text-xs text-muted-foreground">{o.whatsapp}</div>
                </td>
                <td class="py-3"><span class="rounded-full bg-primary/10 text-primary px-2 py-0.5 text-xs">{o.service_type}</span></td>
                <td class="py-3 text-right font-medium">{fmt(Number((o.pricing as any)?.grand_total ?? 0))}</td>
                <td class="py-3 text-xs">{o.status}</td>
                <td class="py-3 text-right">
                  <a href={`/admin/orders/${o.id}`} class="inline-flex items-center gap-1 text-primary hover:underline text-xs">
                    <Eye class="h-3.5 w-3.5" /> Detail
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <Pagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
      </div>
    )}
  </div>
</AdminLayout>
