---
import AdminLayout from '../_layout.astro'
import { ArrowLeft, Phone } from 'lucide-astro'

const { id } = Astro.params
---

<AdminLayout title="Order Detail">
  <a href="/admin/orders" class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground mb-4 transition">
    <ArrowLeft class="h-3.5 w-3.5" />
    Kembali ke orders
  </a>

  <div class="glass-panel rounded-2xl p-5">
    <div id="order-loading" class="py-12 text-center text-sm text-muted-foreground">Memuat order...</div>
    <div id="order-error" class="hidden py-12 text-center text-destructive text-sm">Order tidak ditemukan.</div>

    <div id="order-detail" class="hidden">
      <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div>
          <h2 id="od-id" class="font-mono text-sm text-muted-foreground"></h2>
          <h1 id="od-customer" class="text-xl font-bold tracking-tight mt-0.5"></h1>
        </div>
        <a id="od-wa-link" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-lg bg-green-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-green-600 transition">
          <Phone class="h-3.5 w-3.5" /> WhatsApp
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="rounded-lg border border-border bg-card/40 px-4 py-3">
          <p class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">Layanan</p>
          <p id="od-service" class="mt-1 text-sm font-medium"></p>
        </div>
        <div class="rounded-lg border border-border bg-card/40 px-4 py-3">
          <p class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">Status</p>
          <p id="od-status" class="mt-1 text-sm font-medium"></p>
        </div>
        <div class="rounded-lg border border-border bg-card/40 px-4 py-3">
          <p class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">WhatsApp</p>
          <p id="od-whatsapp" class="mt-1 text-sm font-medium"></p>
        </div>
        <div class="rounded-lg border border-border bg-card/40 px-4 py-3">
          <p class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold">Dibuat</p>
          <p id="od-created" class="mt-1 text-sm font-medium"></p>
        </div>
      </div>
      <div class="rounded-lg border border-border bg-card/40 px-4 py-3 mt-3">
        <p class="text-[10px] uppercase tracking-wide text-muted-foreground font-semibold mb-1">Deskripsi Project</p>
        <p id="od-description" class="text-sm text-foreground/90 leading-relaxed whitespace-pre-wrap"></p>
      </div>
    </div>
  </div>

  <div class="glass-panel rounded-2xl p-5 mt-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground mb-3">Update Status</h2>
    <form id="status-form" class="flex gap-2 items-center flex-wrap">
      <select id="status-select" class="rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
        <option value="">Pilih status...</option>
        <option value="new">Baru</option>
        <option value="contacted">Dihubungi</option>
        <option value="in_progress">Dikerjakan</option>
        <option value="done">Selesai</option>
        <option value="cancelled">Dibatalkan</option>
      </select>
      <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition active:scale-[0.98]">Update</button>
    </form>
    <p id="status-result" class="mt-2 text-xs text-muted-foreground"></p>
  </div>
</AdminLayout>

<script define:vars={{ id }}>
  const SERVICE_LABEL = { website: 'Website Development', mobile: 'Mobile App Development', service_device: 'Maintenance Server & Web', wordpress: 'Website', editing: 'Other' }
  const loadingEl = document.getElementById('order-loading')
  const errorEl = document.getElementById('order-error')
  const detailEl = document.getElementById('order-detail')

  async function loadOrder() {
    try {
      // Use admin endpoint (fixes the bug where it fetched from public /api/order/:id)
      const response = await fetch(`/api/admin/orders/${id}`)
      const result = await response.json()
      if (!response.ok || !result.success) throw new Error(result.error || 'Failed')

      const order = result.data
      loadingEl?.classList.add('hidden')
      detailEl?.classList.remove('hidden')

      document.getElementById('od-id').textContent = 'ORD-' + String(order.id).slice(0, 8)
      document.getElementById('od-customer').textContent = order.customer_name || 'N/A'
      document.getElementById('od-service').textContent = SERVICE_LABEL[order.service_type] || order.service_type || 'N/A'
      document.getElementById('od-status').textContent = order.status || 'N/A'
      document.getElementById('od-whatsapp').textContent = order.whatsapp || 'N/A'
      document.getElementById('od-description').textContent = order.description || order.scope?.description || 'Tidak ada deskripsi'
      document.getElementById('od-created').textContent = order.created_at ? new Date(order.created_at).toLocaleString('id-ID') : 'N/A'

      const waLink = document.getElementById('od-wa-link')
      if (waLink && order.whatsapp) {
        waLink.href = `https://wa.me/${order.whatsapp.replace(/\D/g, '')}`
      }
    } catch {
      loadingEl?.classList.add('hidden')
      errorEl?.classList.remove('hidden')
    }
  }

  loadOrder()

  const form = document.getElementById('status-form')
  const select = document.getElementById('status-select')
  const result = document.getElementById('status-result')
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const status = select?.value
    if (!status) return
    const res = await fetch(`/api/admin/orders/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    })
    if (res.ok) {
      result.textContent = '✓ Status diupdate. Memuat ulang...'
      setTimeout(() => window.location.reload(), 600)
    } else {
      const { error } = await res.json().catch(() => ({ error: 'Failed' }))
      result.textContent = '✗ Gagal: ' + error
    }
  })
</script>
