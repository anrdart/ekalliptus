---
interface Props {
  title: string
  url: string
  description?: string
  image?: string
  showLabels?: boolean
  className?: string
}

const {
  title,
  url,
  description = '',
  image,
  showLabels = true,
  className = ''
} = Astro.props

// URL encode functions
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)
const encodedDescription = encodeURIComponent(description)
const encodedImage = image ? encodeURIComponent(image) : ''

// Platform configurations
const platforms = [
  {
    name: 'WhatsApp',
    id: 'whatsapp',
    color: '#25D366',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
    shareUrl: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    ariaLabel: 'Share to WhatsApp'
  },
  {
    name: 'Facebook',
    id: 'facebook',
    color: '#1877F2',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.518c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
    shareUrl: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&t=${encodedTitle}`,
    ariaLabel: 'Share to Facebook'
  },
  {
    name: 'X (Twitter)',
    id: 'twitter',
    color: '#000000',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    shareUrl: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}&via=ekalliptus`,
    ariaLabel: 'Share to X'
  },
  {
    name: 'LinkedIn',
    id: 'linkedin',
    color: '#0A66C2',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    shareUrl: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}&title=${encodedTitle}&summary=${encodedDescription}`,
    ariaLabel: 'Share to LinkedIn'
  },
  {
    name: 'Telegram',
    id: 'telegram',
    color: '#26A5E4',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12.056 0h-.112zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
    shareUrl: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
    ariaLabel: 'Share to Telegram'
  },
  {
    name: 'Pinterest',
    id: 'pinterest',
    color: '#E60023',
    icon: `<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.669.967-2.913 2.171-2.913 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/></svg>`,
    shareUrl: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodedImage}&description=${encodedTitle}`,
    ariaLabel: 'Share to Pinterest'
  },
  {
    name: 'Email',
    id: 'email',
    color: '#666666',
    icon: `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    shareUrl: `mailto:?subject=${encodedTitle}&body=${encodedDescription}%0A%0A${encodedUrl}`,
    ariaLabel: 'Share via Email'
  }
]
---

<div class={`social-share ${className}`}>
  <span class="social-share-label text-sm font-medium text-muted-foreground mb-2 block">Bagikan:</span>

  <div class="flex flex-wrap gap-2">
    {platforms.map(platform => (
      <a
        href={platform.shareUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="social-share-button group relative inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-all hover:scale-105"
        style={`--platform-color: ${platform.color}`}
        aria-label={platform.ariaLabel}
      >
        <span class="social-share-icon transition-transform group-hover:scale-110" style="color: ${platform.color}" set:html={platform.icon} />
        {showLabels && (
          <span class="social-share-name text-muted-foreground group-hover:text-foreground transition-colors">
            {platform.name}
          </span>
        )}
      </a>
    ))}

    <!-- Copy Link Button -->
    <button
      id="copy-link-btn"
      class="social-share-button group inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-all hover:scale-105 bg-card/30 border border-border/20 hover:bg-card/50"
      aria-label="Copy link to clipboard"
    >
      <svg class="h-5 w-5 text-muted-foreground group-hover:text-foreground transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
      {showLabels && (
        <span id="copy-link-text" class="text-muted-foreground group-hover:text-foreground transition-colors">
          Copy Link
        </span>
      )}
    </button>
  </div>
</div>

<script define:vars={{ url }} is:inline>
  const copyBtn = document.getElementById('copy-link-btn')
  const copyText = document.getElementById('copy-link-text')

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url)

        // Visual feedback
        if (copyText) {
          const originalText = copyText.textContent
          copyText.textContent = 'Copied!'
          copyText.style.color = '#22c55e'

          setTimeout(() => {
            copyText.textContent = originalText
            copyText.style.color = ''
          }, 2000)
        }

        // Optional: Show toast notification
        const toast = document.createElement('div')
        toast.className = 'fixed bottom-4 right-4 bg-primary text-primary-foreground px-4 py-2 rounded-lg shadow-lg z-50 animate-fade-in'
        toast.textContent = 'Link copied to clipboard!'
        document.body.appendChild(toast)

        setTimeout(() => {
          toast.remove()
        }, 2000)
      } catch (err) {
        console.error('Failed to copy:', err)
      }
    })
  }
</script>

<style>
  .social-share-button {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .social-share-button:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--platform-color, rgba(255, 255, 255, 0.2));
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }
</style>
