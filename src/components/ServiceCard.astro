---
import { Globe, Smartphone, Palette, Video, Monitor, Wrench, PenTool, Check, ArrowRight } from 'lucide-astro'

interface Props {
  icon: string
  title: string
  description: string
  features?: string[]
  category?: string
  delay?: number
  href?: string
  cta?: string
}

const { icon, title, description, features = [], category, delay = 0, href = '/order', cta = 'Selengkapnya' } = Astro.props

const iconMap: Record<string, any> = {
  Globe,
  Smartphone,
  Palette,
  Video,
  Monitor,
  Wrench,
  PenTool,
}

const IconComponent = iconMap[icon] || Globe
---

<a
  href={href}
  class="bento-reveal group glass-card relative flex flex-col overflow-hidden rounded-3xl p-6 opacity-0 translate-y-8 transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5 active:scale-[0.99] sm:p-7 cursor-interactive"
  style={`transition-delay: ${delay}ms`}
>
  <!-- hover gradient sheen -->
  <div
    class="bg-gradient-brand pointer-events-none absolute -right-12 -top-12 h-32 w-32 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-20"
  >
  </div>

  <div class="relative z-10 flex items-center justify-between">
    <div
      class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-primary/20 to-accent2/20 transition-transform group-hover:scale-110 sm:h-14 sm:w-14"
    >
      <IconComponent class="h-6 w-6 text-primary sm:h-7 sm:w-7" />
    </div>
    {
      category && (
        <span class="rounded-full bg-card/40 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-muted-foreground">
          {category}
        </span>
      )
    }
  </div>

  <h3 class="relative z-10 mb-2 mt-4 text-lg font-semibold text-foreground sm:text-xl">{title}</h3>

  <p class="relative z-10 mb-4 text-sm leading-relaxed text-muted-foreground">{description}</p>

  {
    features.length > 0 && (
      <ul class="relative z-10 mb-5 space-y-2">
        {features.slice(0, 3).map((feature) => (
          <li class="flex items-start gap-2 text-sm text-muted-foreground">
            <Check class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )
  }

  <span
    class="relative z-10 mt-auto inline-flex items-center gap-2 text-sm font-medium text-primary transition-all group-hover:gap-3"
  >
    {cta}
    <ArrowRight class="h-4 w-4" />
  </span>
</a>
