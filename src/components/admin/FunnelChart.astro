---
interface Props {
  stages: Array<{ name: string; count: number }>
}
const { stages } = Astro.props
const max = Math.max(...stages.map((s) => s.count), 1)
---
<div class="space-y-2">
  {stages.map((s, i) => {
    const width = Math.round((s.count / max) * 100)
    const conv = i > 0 ? Math.round((s.count / Math.max(stages[i - 1].count, 1)) * 100) : 100
    return (
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="font-medium">{s.name}</span>
          <span class="text-muted-foreground">{s.count} {i > 0 && <>· {conv}% konversi</>}</span>
        </div>
        <div class="h-8 overflow-hidden rounded-lg bg-muted/30">
          <div
            class="bg-gradient-brand flex h-full items-center justify-end rounded-lg px-2 text-[0.7rem] font-semibold text-white/90 transition-all duration-500"
            style={`width:${Math.max(width, 6)}%`}
          >
            {width > 18 && s.count}
          </div>
        </div>
      </div>
    )
  })}
</div>
