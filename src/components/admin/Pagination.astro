---
import { ChevronLeft, ChevronRight } from 'lucide-astro'

interface Props {
  page: number
  totalPages: number
  baseUrl: string  // includes existing query params except `page`
}

const { page, totalPages, baseUrl } = Astro.props
const sep = baseUrl.includes('?') ? '&' : '?'
const prevUrl = page > 1 ? `${baseUrl}${sep}page=${page - 1}` : null
const nextUrl = page < totalPages ? `${baseUrl}${sep}page=${page + 1}` : null
---
<nav class="flex items-center justify-between mt-4 text-sm" aria-label="Pagination">
  <p class="text-muted-foreground">Halaman {page} dari {totalPages}</p>
  <div class="flex gap-2">
    {prevUrl ? (
      <a href={prevUrl} class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-1.5 hover:bg-accent">
        <ChevronLeft class="h-4 w-4" /> Sebelumnya
      </a>
    ) : (
      <span class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-1.5 text-muted-foreground opacity-50">
        <ChevronLeft class="h-4 w-4" /> Sebelumnya
      </span>
    )}
    {nextUrl ? (
      <a href={nextUrl} class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-1.5 hover:bg-accent">
        Selanjutnya <ChevronRight class="h-4 w-4" />
      </a>
    ) : (
      <span class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-1.5 text-muted-foreground opacity-50">
        Selanjutnya <ChevronRight class="h-4 w-4" />
      </span>
    )}
  </div>
</nav>
