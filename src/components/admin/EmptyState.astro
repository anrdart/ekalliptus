---
interface Props {
  icon?: any
  title: string
  description?: string
  ctaLabel?: string
  ctaHref?: string
}

const { icon: Icon, title, description, ctaLabel, ctaHref } = Astro.props
---
<div class="flex flex-col items-center justify-center text-center py-12 px-6">
  {Icon && (
    <div class="h-12 w-12 rounded-full bg-muted/40 flex items-center justify-center mb-4">
      <Icon class="h-6 w-6 text-muted-foreground" />
    </div>
  )}
  <h3 class="text-base font-semibold mb-1">{title}</h3>
  {description && <p class="text-sm text-muted-foreground max-w-sm">{description}</p>}
  {ctaLabel && ctaHref && (
    <a href={ctaHref} class="mt-4 inline-flex items-center rounded-xl bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
      {ctaLabel}
    </a>
  )}
</div>
