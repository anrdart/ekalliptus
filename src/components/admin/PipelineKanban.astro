---
import type { Lead, LeadStage } from '../../types/database'
import { LEAD_STAGE_LABELS, LEAD_STAGE_ORDER } from '../../lib/admin/leads'
import { formatIDR } from '../../lib/format'

interface Props {
  board: Record<LeadStage, Lead[]>
}
const { board } = Astro.props

const fmt = (n: number | null) => (n ? formatIDR(n) : '')
const stageColor = (stage: LeadStage) => `hsl(var(--status-${stage}))`
const SERVICE_LABEL: Record<string, string> = { website: 'Web', mobile: 'Mobile', service_device: 'Maintenance' }
---
<div class="flex gap-3 overflow-x-auto pb-2" id="kanban-board">
  {LEAD_STAGE_ORDER.map((stage) => (
    <div class="kanban-col flex-shrink-0 w-64 glass-panel rounded-2xl p-3" data-stage={stage}>
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full" style={`background:${stageColor(stage)}`}></span>
          <span class="text-xs font-bold uppercase tracking-wider">{LEAD_STAGE_LABELS[stage]}</span>
          <span class="text-xs text-muted-foreground count-badge">({board[stage].length})</span>
        </div>
      </div>
      <div class="kanban-list space-y-2 min-h-[80px] rounded-lg p-1 transition-colors" data-stage={stage}>
        {board[stage].length === 0 && (
          <div class="empty-state text-center py-6 text-xs text-muted-foreground/50 border border-dashed border-border/50 rounded-lg">
            Kosong
          </div>
        )}
        {board[stage].map((lead) => (
          <div
            class="kanban-card rounded-lg bg-card border border-border p-2.5 cursor-grab transition-all hover:shadow-md hover:border-primary/30 active:cursor-grabbing"
            draggable="true"
            data-id={lead.id}
            data-name={lead.name}
            data-whatsapp={lead.whatsapp ?? ''}
            data-company={lead.company ?? ''}
            data-service={lead.service_interest ?? ''}
            data-value={String(lead.estimated_value ?? '')}
            data-notes={lead.notes ?? ''}
            style={`border-left: 3px solid ${stageColor(stage)}`}
          >
            <div class="font-medium text-sm">{lead.name}</div>
            {lead.service_interest && <div class="text-[11px] text-muted-foreground mt-0.5">{SERVICE_LABEL[lead.service_interest] ?? lead.service_interest}</div>}
            <div class="flex items-center justify-between mt-1.5">
              {lead.estimated_value ? <div class="text-[11px] font-semibold" style={`color:${stageColor(stage)}`}>{fmt(Number(lead.estimated_value))}</div> : <div></div>}
              <span class="edit-hint text-[10px] text-muted-foreground/40 opacity-0 transition-opacity">klik edit</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .kanban-list.drag-over {
    background: hsl(var(--primary) / 0.08);
    outline: 2px dashed hsl(var(--primary) / 0.4);
    outline-offset: -2px;
  }
  .kanban-card:hover .edit-hint { opacity: 1; }
  .kanban-card.moving { opacity: 0.4; }
</style>

<script>
  const board = document.getElementById('kanban-board')
  if (board) {
    let draggedId: string | null = null
    let draggedCard: HTMLElement | null = null

    // ---- Drag & drop (SPA, no reload) ----
    board.querySelectorAll<HTMLElement>('.kanban-card').forEach((card) => {
      card.addEventListener('dragstart', (e) => {
        draggedId = card.dataset.id ?? null
        draggedCard = card
        card.classList.add('moving')
        if (draggedId) e.dataTransfer?.setData('text/plain', draggedId)
      })
      card.addEventListener('dragend', () => {
        card.classList.remove('moving')
        draggedId = null
        draggedCard = null
        board.querySelectorAll('.kanban-list').forEach(l => l.classList.remove('drag-over'))
      })
      // Click → edit modal
      card.addEventListener('click', () => openEditModal(card))
    })

    board.querySelectorAll<HTMLElement>('.kanban-list').forEach((list) => {
      list.addEventListener('dragover', (e) => {
        e.preventDefault()
        list.classList.add('drag-over')
      })
      list.addEventListener('dragleave', (e) => {
        if (!list.contains(e.relatedTarget as Node)) list.classList.remove('drag-over')
      })
      list.addEventListener('drop', async (e) => {
        e.preventDefault()
        list.classList.remove('drag-over')
        if (!draggedId || !draggedCard) return
        const newStage = list.dataset.stage
        if (!newStage) return

        const col = list.closest('.kanban-col') as HTMLElement | null
        const res = await fetch(`/api/admin/leads/${draggedId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stage: newStage })
        })
        if (res.ok) {
          // SPA move: relocate the card DOM node + update counts (no reload)
          list.appendChild(draggedCard)
          // Update card left-border to new stage color
          const colStage = col?.dataset.stage
          if (colStage) {
            const color = `hsl(var(--status-${colStage}))`
            draggedCard.style.borderLeftColor = color
            const valEl = draggedCard.querySelector<HTMLElement>('.font-semibold')
            if (valEl) valEl.style.color = color
          }
          recountAll()
          toast(`✓ Dipindah ke ${stageLabel(newStage ?? '')}`)
        } else {
          const { error } = await res.json().catch(() => ({ error: 'Gagal' }))
          toast(`✗ Gagal: ${error}`, true)
        }
      })
    })

    // ---- Helpers ----
    const STAGE_LABELS: Record<string, string> = {
      new: 'Baru', contacted: 'Dihubungi', qualified: 'Qualified',
      proposal: 'Proposal', negotiation: 'Negosiasi', won: 'Won', lost: 'Lost'
    }
    function stageLabel(s: string) { return STAGE_LABELS[s] ?? s }

    function recountAll() {
      board!.querySelectorAll<HTMLElement>('.kanban-col').forEach(col => {
        const stage = col.dataset.stage
        const count = col.querySelectorAll('.kanban-card').length
        const badge = col.querySelector('.count-badge')
        if (badge) badge.textContent = `(${count})`
        // Toggle empty state
        const empty = col.querySelector('.empty-state')
        if (count === 0) {
          if (!empty) {
            const el = document.createElement('div')
            el.className = 'empty-state text-center py-6 text-xs text-muted-foreground/50 border border-dashed border-border/50 rounded-lg'
            el.textContent = 'Kosong'
            col.querySelector('.kanban-list')?.appendChild(el)
          }
        } else {
          empty?.remove()
        }
      })
    }

    // ---- Toast (non-blocking feedback) ----
    function toast(msg: string, isError = false) {
      let el = document.getElementById('kanban-toast')
      if (!el) {
        el = document.createElement('div')
        el.id = 'kanban-toast'
        el.className = 'fixed bottom-5 left-1/2 -translate-x-1/2 z-50 glass-panel rounded-full px-4 py-2 text-xs font-medium shadow-lg transition-all duration-300'
        document.body.appendChild(el)
      }
      el.textContent = msg
      el.style.color = isError ? 'hsl(var(--destructive))' : 'hsl(var(--primary))'
      el.style.opacity = '1'
      el.style.transform = 'translateX(-50%) translateY(0)'
      clearTimeout((el as any)._t)
      ;(el as any)._t = setTimeout(() => { el!.style.opacity = '0'; el!.style.transform = 'translateX(-50%) translateY(10px)' }, 2500)
    }

    // ---- Edit modal ----
    const editModal = document.getElementById('lead-edit-modal') as HTMLDialogElement | null
    const editForm = document.getElementById('lead-edit-form') as HTMLFormElement | null
    const editIdInput = document.getElementById('lead-edit-id') as HTMLInputElement | null

    function openEditModal(card: HTMLElement) {
      if (!editModal || !editForm || !editIdInput) return
      editIdInput.value = card.dataset.id ?? ''
      ;(editForm.elements.namedItem('name') as HTMLInputElement).value = card.dataset.name ?? ''
      ;(editForm.elements.namedItem('whatsapp') as HTMLInputElement).value = card.dataset.whatsapp ?? ''
      ;(editForm.elements.namedItem('company') as HTMLInputElement).value = card.dataset.company ?? ''
      ;(editForm.elements.namedItem('service_interest') as HTMLInputElement).value = card.dataset.service ?? ''
      ;(editForm.elements.namedItem('estimated_value') as HTMLInputElement).value = card.dataset.value ?? ''
      ;(editForm.elements.namedItem('notes') as HTMLTextAreaElement).value = card.dataset.notes ?? ''
      editModal.showModal()
    }

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const id = editIdInput?.value
      if (!id) return
      const fd = new FormData(editForm)
      const data: any = Object.fromEntries(fd)
      if (data.estimated_value) data.estimated_value = Number(data.estimated_value)
      const res = await fetch(`/api/admin/leads/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      if (res.ok) {
        editModal?.close()
        window.location.reload()
      } else {
        toast('✗ Gagal update', true)
      }
    })

    document.getElementById('lead-edit-cancel')?.addEventListener('click', () => editModal?.close())
    document.getElementById('lead-delete-btn')?.addEventListener('click', async () => {
      const id = editIdInput?.value
      if (!id || !confirm('Hapus lead ini?')) return
      const res = await fetch(`/api/admin/leads/${id}`, { method: 'DELETE' })
      if (res.ok) { editModal?.close(); window.location.reload() }
      else toast('✗ Gagal hapus', true)
    })
  }
</script>

<!-- Edit modal (rendered by parent pipeline page, but script lives here) -->
<dialog id="lead-edit-modal" class="rounded-2xl p-0 backdrop:bg-black/50 max-w-[90vw]">
  <form id="lead-edit-form" class="glass-panel p-5 w-[380px] max-w-[90vw]">
    <h3 class="text-sm font-semibold mb-3">Edit Lead</h3>
    <input type="hidden" id="lead-edit-id" name="id" />
    <div class="space-y-2.5">
      <input name="name" placeholder="Nama" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
      <input name="whatsapp" placeholder="WhatsApp" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
      <input name="company" placeholder="Perusahaan" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
      <select name="service_interest" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30">
        <option value="">Pilih layanan...</option>
        <option value="website">Website</option>
        <option value="mobile">Mobile App</option>
        <option value="service_device">Maintenance</option>
      </select>
      <input name="estimated_value" type="number" placeholder="Estimasi nilai (Rp)" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30" />
      <textarea name="notes" placeholder="Catatan" rows="2" class="w-full rounded-lg border border-border bg-input px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 resize-none"></textarea>
    </div>
    <div class="mt-4 flex justify-between gap-2">
      <button type="button" id="lead-delete-btn" class="rounded-lg border border-destructive/40 text-destructive px-3 py-1.5 text-xs hover:bg-destructive/10 transition">Hapus</button>
      <div class="flex gap-2">
        <button type="button" id="lead-edit-cancel" class="rounded-lg border border-border px-3 py-1.5 text-xs hover:bg-accent/40 transition">Batal</button>
        <button type="submit" class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition">Simpan</button>
      </div>
    </div>
  </form>
</dialog>
