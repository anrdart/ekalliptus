---
import type { Lead, LeadStage } from '../../types/database'
import { LEAD_STAGE_LABELS, LEAD_STAGE_ORDER } from '../../lib/admin/leads'

interface Props {
  board: Record<LeadStage, Lead[]>
}
const { board } = Astro.props

import { formatIDR } from '../../lib/format'

const fmt = (n: number | null) => (n ? formatIDR(n) : '')

// Each stage maps to a --status-* token (defined in global.css) so the palette
// stays consistent with StatusBadge and adapts to light/dark automatically.
const stageColor = (stage: LeadStage) => `hsl(var(--status-${stage}))`
---
<div class="flex gap-3 overflow-x-auto pb-2" id="kanban-board">
  {LEAD_STAGE_ORDER.map((stage) => (
    <div class="kanban-col flex-shrink-0 w-64 glass-card rounded-2xl p-3" data-stage={stage}>
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full" style={`background:${stageColor(stage)}`}></span>
          <span class="text-xs font-bold uppercase tracking-wider">{LEAD_STAGE_LABELS[stage]}</span>
          <span class="text-xs text-muted-foreground">({board[stage].length})</span>
        </div>
      </div>
      <div class="kanban-list space-y-2 min-h-[100px]" data-stage={stage}>
        {board[stage].map((lead) => (
          <div
            class="kanban-card rounded-xl bg-background border border-border p-3 cursor-grab transition-shadow hover:shadow-md active:cursor-grabbing"
            draggable="true"
            data-id={lead.id}
            style={`border-left: 3px solid ${stageColor(stage)}`}
          >
            <div class="font-medium text-sm">{lead.name}</div>
            {lead.service_interest && <div class="text-xs text-muted-foreground mt-0.5">{lead.service_interest}</div>}
            {lead.estimated_value && <div class="text-xs font-semibold mt-1" style={`color:${stageColor(stage)}`}>{fmt(Number(lead.estimated_value))}</div>}
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  const board = document.getElementById('kanban-board')
  if (board) {
    let draggedId: string | null = null

    board.querySelectorAll<HTMLElement>('.kanban-card').forEach((card) => {
      card.addEventListener('dragstart', (e) => {
        draggedId = card.dataset.id ?? null
        card.classList.add('opacity-50')
      })
      card.addEventListener('dragend', () => {
        card.classList.remove('opacity-50')
        draggedId = null
      })
    })

    board.querySelectorAll<HTMLElement>('.kanban-list').forEach((list) => {
      list.addEventListener('dragover', (e) => {
        e.preventDefault()
        list.classList.add('bg-accent/30', 'rounded-lg')
      })
      list.addEventListener('dragleave', () => {
        list.classList.remove('bg-accent/30', 'rounded-lg')
      })
      list.addEventListener('drop', async (e) => {
        e.preventDefault()
        list.classList.remove('bg-accent/30', 'rounded-lg')
        if (!draggedId) return
        const newStage = list.dataset.stage
        const res = await fetch(`/api/admin/leads/${draggedId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stage: newStage })
        })
        if (res.ok) {
          window.location.reload()
        } else {
          const { error } = await res.json().catch(() => ({ error: 'Gagal' }))
          alert(`Gagal pindah stage: ${error}`)
        }
      })
    })
  }
</script>
