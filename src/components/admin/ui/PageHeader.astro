---
/**
 * Page header for admin list pages. Unifies the divergent top-bar variants
 * (blog/pipeline had bespoke flex rows; orders/customers had none).
 *
 * Slots:
 *   - default slot → right-aligned actions (e.g. a "New" button)
 */
interface Props {
  title: string
  count?: number | string
  countLabel?: string
  subtitle?: string
  class?: string
}

const { title, count, countLabel, subtitle, class: extra = '' } = Astro.props
const hasCount = count !== undefined && count !== null
---

<div class={`mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between ${extra}`}>
  <div>
    <h1 class="text-xl font-bold text-foreground sm:text-2xl">{title}</h1>
    {
      (hasCount || subtitle) && (
        <p class="mt-1 text-sm text-muted-foreground">
          {hasCount && (
            <span class="font-medium text-foreground">{count}</span>
          )}
          {hasCount && countLabel ? ` ${countLabel}` : ''}
          {hasCount && subtitle ? ' · ' : ''}
          {subtitle}
        </p>
      )
    }
  </div>
  <div class="flex flex-shrink-0 items-center gap-2">
    <slot />
  </div>
</div>
