---
/**
 * Status badge with a colored dot, driven by --status-* CSS tokens.
 *
 * Fixes the prior UX gap where orders/payments rendered status as plain,
 * uncolored text. One map covers order, payment, lead/pipeline, and blog
 * statuses; unknown values fall back to a neutral "info" style + raw label.
 */
interface Props {
  status: string
  class?: string
}

const { status, class: extra = '' } = Astro.props

const key = String(status ?? '').toLowerCase().trim()

// status key -> { token (CSS var suffix), label (Indonesian) }
const map: Record<string, { token: string; label: string }> = {
  // orders
  new: { token: 'new', label: 'Baru' },
  contacted: { token: 'contacted', label: 'Dihubungi' },
  in_progress: { token: 'processing', label: 'Dikerjakan' },
  done: { token: 'won', label: 'Selesai' },
  cancelled: { token: 'lost', label: 'Dibatalkan' },
  // payments
  pending: { token: 'pending', label: 'Pending' },
  processing: { token: 'processing', label: 'Diproses' },
  paid: { token: 'paid', label: 'Lunas' },
  failed: { token: 'failed', label: 'Gagal' },
  expired: { token: 'lost', label: 'Kedaluwarsa' },
  refunded: { token: 'new', label: 'Refund' },
  // leads / pipeline
  qualified: { token: 'qualified', label: 'Qualified' },
  proposal: { token: 'proposal', label: 'Proposal' },
  negotiation: { token: 'negotiation', label: 'Negosiasi' },
  won: { token: 'won', label: 'Won' },
  lost: { token: 'lost', label: 'Lost' },
  // blog
  published: { token: 'paid', label: 'Published' },
  draft: { token: 'new', label: 'Draft' },
  archived: { token: 'proposal', label: 'Archived' },
}

const entry = map[key] ?? { token: 'info', label: status || '—' }
const token = entry.token
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${extra}`}
  style={`background-color: hsl(var(--status-${token}) / 0.14); color: hsl(var(--status-${token}));`}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background-color: hsl(var(--status-${token}))`}></span>
  {entry.label}
</span>
