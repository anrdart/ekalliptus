---
/**
 * Filter pill / tab. Extracted from the activities filter bar; reusable as a
 * status-tab row on any list page. Renders an <a> (filter links via querystring).
 */
interface Props {
  href: string
  active?: boolean
  class?: string
}

const { href, active = false, class: extra = '' } = Astro.props

const cls = active
  ? 'border-primary bg-primary text-primary-foreground shadow-sm'
  : 'border-border text-muted-foreground hover:bg-accent/40 hover:text-foreground'
---

<a
  href={href}
  class={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-3.5 py-1.5 text-sm font-medium transition cursor-interactive ${cls} ${extra}`}
>
  <slot />
</a>
