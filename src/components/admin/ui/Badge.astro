---
/**
 * Generic pill badge. Replaces inline `rounded-full bg-primary/10 …` chips.
 */
interface Props {
  variant?: 'primary' | 'success' | 'warning' | 'muted' | 'destructive' | 'info'
  size?: 'xs' | 'sm'
  class?: string
}

const { variant = 'primary', size = 'xs', class: extra = '' } = Astro.props

const variants: Record<string, string> = {
  primary: 'bg-primary/10 text-primary',
  success: 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400',
  warning: 'bg-amber-500/15 text-amber-600 dark:text-amber-400',
  muted: 'bg-muted text-muted-foreground',
  destructive: 'bg-destructive/10 text-destructive',
  info: 'bg-blue-500/15 text-blue-600 dark:text-blue-400',
}

const sizes: Record<string, string> = {
  xs: 'px-2 py-0.5 text-[0.7rem]',
  sm: 'px-2.5 py-1 text-xs',
}

const cls = `inline-flex items-center gap-1 rounded-full font-medium ${variants[variant]} ${sizes[size]} ${extra}`
---

<span class={cls}><slot /></span>
