# Ekalliptus — environment variables
# Copy to `.env` (gitignored). These are read at BUILD TIME by Vite/Astro and
# inlined into the bundle (readEnv() falls back to import.meta.env), so the SAME
# vars must be set as Build variables/secrets in Cloudflare Workers Builds.

# --- Supabase (required) ---
# Public, client-visible (RLS-guarded anon key):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only mirror used by SSR/admin (same values as above):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only, NEVER expose to client:
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI consult (eBot) ---
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=your_zai_api_key
ZAI_MODEL=glm-4-flash
# Shared token the consult widget sends in x-consult-token header:
CONSULT_SECRET=ekalliptus-consult-2026

# --- Admin ---
# Set to "true" ONLY for local dev to bypass auth. Leave unset in production.
ADMIN_AUTH_DISABLED=

# --- SEO verification (optional, leave blank if unused) ---
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# --- Misc ---
PUBLIC_URL=https://ekalliptus.com

# --- Telegram order notification (used by Supabase Edge Function, not the Worker) ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_group_id
