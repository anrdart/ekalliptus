---
import { FileText, MessagesSquare, Hammer, PackageCheck } from 'lucide-astro'

interface Props {
  t: (key: string) => string
}

const { t } = Astro.props

const steps = [
  { icon: FileText, title: t('home.process.step1Title'), desc: t('home.process.step1Desc') },
  { icon: MessagesSquare, title: t('home.process.step2Title'), desc: t('home.process.step2Desc') },
  { icon: Hammer, title: t('home.process.step3Title'), desc: t('home.process.step3Desc') },
  { icon: PackageCheck, title: t('home.process.step4Title'), desc: t('home.process.step4Desc') },
]
---

<section id="process" class="content-vis relative px-4 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-2xl text-center sm:mb-16">
      <span class="text-xs font-semibold uppercase tracking-[0.35em] text-primary">{t('home.process.eyebrow')}</span>
      <h2 class="mt-3 text-3xl font-bold text-foreground sm:text-4xl">{t('home.process.title')}</h2>
      <p class="mt-3 text-base text-muted-foreground sm:text-lg">{t('home.process.subtitle')}</p>
    </div>

    <ol class="relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      <!-- connecting line on desktop -->
      <div
        class="bg-primary pointer-events-none absolute left-0 right-0 top-7 hidden h-0.5 opacity-30 lg:block"
        aria-hidden="true"
      >
      </div>

      {
        steps.map((step, i) => (
          <li class="bento-reveal relative opacity-0 translate-y-8 transition-all duration-500" style={`transition-delay: ${i * 90}ms`}>
            <div class="flex items-center gap-3 lg:flex-col lg:items-start">
              <div class="relative z-10 inline-flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-background ring-1 ring-border">
                <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10">
                  <step.icon class="h-5 w-5 text-primary" />
                </div>
                <span class="bg-primary absolute -right-1 -top-1 inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold text-white shadow">
                  {i + 1}
                </span>
              </div>
            </div>
            <h3 class="mt-4 text-base font-semibold text-foreground sm:text-lg">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const items = document.querySelectorAll('#process .bento-reveal')
  if (items.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-8')
            entry.target.classList.add('opacity-100', 'translate-y-0')
            io.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.2 }
    )
    items.forEach((el) => io.observe(el))
  }
</script>
