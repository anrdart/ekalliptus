---
import { ArrowUpRight, Globe, Smartphone, ShieldCheck } from 'lucide-astro'
interface Props { t: (key: string) => string }
const { t } = Astro.props
const services = [
  { key: 'websiteDevelopment', icon: Globe, href: '/services/website' },
  { key: 'mobileAppDevelopment', icon: Smartphone, href: '/services/mobile-app' },
  { key: 'websiteMaintenance', icon: ShieldCheck, href: '/services/maintenance' },
]
---
<section id="services" class="studio-services scroll-mt-24">
  <div class="services-heading"><h2>{t('home.services.title')}</h2><p>{t('home.services.subtitle')}</p></div>
  <div class="service-rows">
    {services.map(({ key, icon: Icon, href }) => (
      <a href={href} class="service-row">
        <span class="service-symbol"><Icon size={30} aria-hidden="true" /></span>
        <h3>{t(`services.cards.${key}.title`)}</h3>
        <div><p>{t(`services.cards.${key}.description`)}</p><ul>{Array.from({ length: 4 }, (_, i) => <li>{t(`services.cards.${key}.features[${i}]`)}</li>)}</ul></div>
        <ArrowUpRight class="service-arrow" aria-hidden="true" />
      </a>
    ))}
  </div>
</section>
