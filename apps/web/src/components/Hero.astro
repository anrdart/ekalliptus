---
import { ArrowUpRight, Globe, Smartphone, ShieldCheck } from 'lucide-astro'
interface Props { t: (key: string) => string }
const { t } = Astro.props
---

<section id="home" class="studio-hero scroll-mt-24">
  <div class="hero-copy">
    <p class="hero-location">Ekalliptus Digital / Indonesia</p>
    <h1>{t('home.hero.titleLead')} {t('home.hero.titleAccent')} {t('home.hero.titleTail')}</h1>
    <p class="hero-description">{t('home.hero.subtitle')}</p>
    <div class="hero-actions">
      <a href="/order" data-track="order" class="studio-button">{t('home.hero.ctaPrimary')}<ArrowUpRight aria-hidden="true" size={20} /></a>
      <a href="#services" class="studio-link">{t('home.hero.ctaSecondary')}</a>
    </div>
  </div>
  <div class="studio-composition">
    <div class="composition-caption">{t('home.hero.badge')}</div>
    <a href="/services/website" class="web-object">
      <div class="object-toolbar"><span></span><span></span><span></span><Globe size={18} aria-hidden="true" /></div>
      <div class="object-content"><img src="/logo_mobile.webp" alt="Ekalliptus Digital" width="200" height="133" class="object-brand" decoding="async" /><div class="object-shapes" aria-hidden="true"><i></i><i></i><i></i></div><strong>{t('services.cards.websiteDevelopment.title')}</strong><ArrowUpRight aria-hidden="true" /></div>
    </a>
    <a href="/services/mobile-app" class="mobile-object"><span class="phone-speaker" aria-hidden="true"></span><Smartphone size={30} aria-hidden="true" /><strong>{t('services.cards.mobileAppDevelopment.title')}</strong><span class="phone-tiles" aria-hidden="true"><i></i><i></i><i></i><i></i></span><ArrowUpRight aria-hidden="true" /></a>
    <a href="/services/maintenance" class="maintenance-object"><ShieldCheck size={24} aria-hidden="true" /><span>{t('services.cards.websiteMaintenance.title')}</span><ArrowUpRight size={18} aria-hidden="true" /></a>
  </div>
</section>
