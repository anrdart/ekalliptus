---
import { ArrowRight, Play, Star, Users, Clock, Zap } from 'lucide-astro'

interface Props {
  t: (key: string) => string
}

const { t } = Astro.props

const trust = [
  { icon: Star, value: '4.9/5', label: t('home.hero.trustRating') },
  { icon: Users, value: '120+', label: t('home.hero.trustClients') },
  { icon: Clock, value: '3+', label: t('home.hero.trustYears') },
  { icon: Zap, value: '< 24 jam', label: t('home.hero.trustResponse') },
]
---

<section
  id="home"
  class="relative flex min-h-[calc(100svh-5rem)] items-center overflow-hidden px-4 scroll-mt-20 lg:scroll-mt-32 bg-background"
>
  <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center gap-8 py-12 sm:py-16">
    <div
      class="hero-content w-full text-center opacity-0 translate-y-8 transition-all duration-700 ease-smooth"
      style="transition-delay: 100ms"
    >
      <!-- Eyebrow badge -->
      <span
        class="glass-pill mb-6 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-medium text-foreground/80 sm:text-sm"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
        </span>
        {t('home.hero.badge')}
      </span>

      <!-- Oversized headline -->
      <h1
        class="mx-auto max-w-4xl font-bold tracking-tight text-foreground"
        style="font-size: clamp(2.25rem, 7vw, 4.5rem); line-height: 1.05;"
      >
        {t('home.hero.titleLead')}{' '}
        <span class="text-primary">{t('home.hero.titleAccent')}</span>{' '}
        {t('home.hero.titleTail')}
      </h1>

      <p class="mx-auto mt-6 max-w-2xl px-2 text-base leading-relaxed text-foreground/70 sm:text-lg md:text-xl">
        {t('home.hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:mt-10 sm:flex-row sm:items-center sm:justify-center sm:gap-4">
        <a
          href="/order"
          data-track="order"
          class="group glow-brand inline-flex min-h-[52px] items-center justify-center gap-3 rounded-full bg-primary px-8 py-4 text-sm font-semibold uppercase tracking-wide text-primary-foreground transition-all duration-300 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 active:scale-[0.98] sm:text-base cursor-interactive"
        >
          {t('home.hero.ctaPrimary')}
          <ArrowRight class="h-5 w-5 transition-transform group-hover:translate-x-1" />
        </a>

        <a
          href="#services"
          class="nav-link group inline-flex min-h-[52px] items-center justify-center gap-2 rounded-full border border-border/40 bg-card/20 px-6 py-4 text-sm font-semibold text-foreground/80 backdrop-blur transition hover:border-border/60 hover:bg-card/30 active:bg-card/40 sm:text-base cursor-interactive"
          data-hash="#services"
        >
          <Play class="h-4 w-4" />
          {t('home.hero.ctaSecondary')}
        </a>
      </div>
    </div>

    <!-- Trust strip -->
    <div
      class="hero-content grid w-full max-w-3xl grid-cols-2 gap-3 opacity-0 translate-y-8 transition-all duration-700 ease-smooth sm:grid-cols-4 sm:gap-4"
      style="transition-delay: 260ms"
    >
      {
        trust.map((item) => (
          <div class="glass-card flex flex-col items-center gap-1 rounded-2xl px-3 py-4 text-center">
            <item.icon class="h-5 w-5 text-primary" />
            <span class="text-lg font-bold text-foreground sm:text-xl">{item.value}</span>
            <span class="text-[0.7rem] leading-tight text-muted-foreground sm:text-xs">{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce text-muted-foreground/50">
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  const heroEls = document.querySelectorAll('.hero-content')

  const reveal = (el: Element) => {
    el.classList.remove('opacity-0', 'translate-y-8')
    el.classList.add('opacity-100', 'translate-y-0')
  }

  if (heroEls.length) {
    // Hero is above the fold — reveal immediately, but keep the transition.
    requestAnimationFrame(() => heroEls.forEach(reveal))
  }
</script>
