---
interface Props {
  locale?: string
  faqItems?: Array<{ question: string; answer: string }>
}

const { locale = 'id', faqItems = [] } = Astro.props
const siteUrl = 'https://ekalliptus.com'
const organizationId = `${siteUrl}#organization`

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: 'Ekalliptus Digital',
  url: siteUrl,
  logo: `${siteUrl}/ekalliptus_rounded.webp`,
  description: 'Digital agency Indonesia untuk pengembangan website, aplikasi mobile, serta maintenance server dan web.',
  email: 'support@ekalliptus.com',
  telephone: '+6281999900306',
  foundingDate: '2023',
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  sameAs: [
    'https://www.linkedin.com/company/ekalliptus',
    'https://github.com/ekalliptus',
    'https://www.instagram.com/ekalliptus'
  ]
}

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: 'Ekalliptus Digital',
  url: siteUrl,
  inLanguage: locale,
  publisher: { '@id': organizationId }
}

const faqSchema = faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null

const schemas = [organization, webSite, ...(faqSchema ? [faqSchema] : [])]
---

{schemas.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
